# =====================================================================
# JomDekan backend — environment variables
# Copy to .env and fill in real values. Never commit .env.
# =====================================================================

NODE_ENV=development
PORT=3000

# Comma-separated list of allowed browser origins. No wildcards.
CORS_ORIGINS=http://localhost:5173

# --- PostgreSQL --------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=jomdekan
DB_SSL=false
DB_POOL_MAX=20

# --- JWT / sessions ------------------------------------------------------
# Generate strong random values, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# HTTP-only cookie name that carries the refresh token
REFRESH_COOKIE_NAME=jomdekan_rt
COOKIE_SECRET=change-me-cookie-signing-secret

# --- Object storage (Milestone 3) ---------------------------------------
# Left unconfigured for Milestone 0/1; a local stub adapter is used until
# a real S3-compatible provider (Supabase Storage / S3 / R2) is wired in.
STORAGE_PROVIDER=local-stub
STORAGE_BUCKET=jomdekan-resources
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- Redis / BullMQ (introduced when background jobs are needed) --------
REDIS_URL=redis://localhost:6379

# --- Email (queued adapter; Milestone 6) ---------------------------------
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@jomdekan.app

# --- Google OAuth (added after password auth is stable) -----------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Rate limiting --------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_AUTH=20
